ADDR=:8080
# DATABASE_URL/REDIS_URL/SETUP_DATABASE_URL are not set here. This
# workspace's Postgres and Redis run in their own isolated Dev Container
# with generated credentials - `just` reads them from the Compose secret
# mount and injects DATABASE_URL/REDIS_URL automatically for every
# recipe that needs them (`just dev`, `just db-migrate`, `just test`,
# ...); SETUP_DATABASE_URL is unused since that container's Postgres
# role/database already exist (POSTGRES_DB/_USER_FILE/_PASSWORD_FILE).
# See compose.dev.yml and justfile.
#
# Optional overrides used only by `just run` for the production-image
# test container (a separate, unrelated flow from the Dev Container's
# own Postgres/Redis - see justfile).
# Docker Desktop usually needs host.docker.internal to reach host services.
DOCKER_DATABASE_URL=postgres://slopyard:slopyard@host.docker.internal:5432/slopyard?sslmode=disable
DOCKER_REDIS_URL=redis://host.docker.internal:6379/0
FINGERPRINT_SECRET=change-me-to-a-long-random-secret
TRUST_PROXY_HEADERS=false
GLOBAL_RATE_LIMIT=20
GLOBAL_RATE_WINDOW=1m
HOST_REPORT_WINDOW=24h
